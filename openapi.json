{"openapi": "3.1.0", "info": {"title": "Linkex SmartHotel API", "version": "1.0.0", "description": "\u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0641\u0646\u062f\u0642 \u0627\u0644\u0630\u0643\u064a - \u0627\u0644\u063a\u0631\u0641\u060c \u0645\u062d\u0631\u0643 \u0627\u0644\u062a\u0648\u0641\u0631\u060c \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a"}, "paths": {"/api/rooms/types": {"get": {"operationId": "apps_rooms_api_list_room_types", "summary": "\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u062c\u0645\u064a\u0639 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u063a\u0631\u0641", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/RoomTypeOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0642\u0627\u0626\u0645\u0629 \u0628\u0643\u0627\u0641\u0629 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u063a\u0631\u0641 \u0648\u0645\u0648\u0627\u0635\u0641\u0627\u062a\u0647\u0627 \u0648\u0623\u0633\u0639\u0627\u0631\u0647\u0627.", "tags": ["\u0627\u0644\u063a\u0631\u0641 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a (Rooms)"]}}, "/api/rooms/types/{type_id}": {"get": {"operationId": "apps_rooms_api_get_room_type", "summary": "\u062a\u0641\u0627\u0635\u064a\u0644 \u062a\u0635\u0646\u064a\u0641 \u0645\u062d\u062f\u062f", "parameters": [{"in": "path", "name": "type_id", "schema": {"title": "Type Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomTypeOut"}}}}}, "tags": ["\u0627\u0644\u063a\u0631\u0641 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a (Rooms)"]}}, "/api/rooms/": {"get": {"operationId": "apps_rooms_api_list_rooms", "summary": "\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u063a\u0631\u0641 \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0644\u0641\u0644\u062a\u0631\u0629", "parameters": [{"in": "query", "name": "room_type_id", "schema": {"anyOf": [{"type": "integer"}, {"type": "null"}], "description": "\u0645\u0639\u0631\u0641 \u0646\u0648\u0639 \u0627\u0644\u063a\u0631\u0641\u0629", "title": "Room Type Id"}, "required": false, "description": "\u0645\u0639\u0631\u0641 \u0646\u0648\u0639 \u0627\u0644\u063a\u0631\u0641\u0629"}, {"in": "query", "name": "status", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}], "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u063a\u0631\u0641\u0629 (available, occupied, maintenance, cleaning)", "title": "Status"}, "required": false, "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u063a\u0631\u0641\u0629 (available, occupied, maintenance, cleaning)"}, {"in": "query", "name": "floor", "schema": {"anyOf": [{"type": "integer"}, {"type": "null"}], "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0628\u0642", "title": "Floor"}, "required": false, "description": "\u0631\u0642\u0645 \u0627\u0644\u0637\u0627\u0628\u0642"}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/RoomOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u062c\u0645\u064a\u0639 \u0627\u0644\u063a\u0631\u0641 \u0645\u0639 \u0641\u0644\u062a\u0631\u0629 \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629 \u0628\u062d\u0633\u0628 \u0627\u0644\u0646\u0648\u0639\u060c \u0627\u0644\u062d\u0627\u0644\u0629 \u0623\u0648 \u0627\u0644\u0637\u0627\u0628\u0642.\n\u064a\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0639\u0631\u0636.", "tags": ["\u0627\u0644\u063a\u0631\u0641 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a (Rooms)"]}}, "/api/rooms/{room_id}": {"get": {"operationId": "apps_rooms_api_get_room", "summary": "\u062a\u0641\u0627\u0635\u064a\u0644 \u063a\u0631\u0641\u0629 \u0645\u062d\u062f\u062f\u0629", "parameters": [{"in": "path", "name": "room_id", "schema": {"title": "Room Id", "type": "integer"}, "required": true}], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoomOut"}}}}}, "tags": ["\u0627\u0644\u063a\u0631\u0641 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a (Rooms)"]}}, "/api/bookings/availability": {"post": {"operationId": "apps_bookings_api_check_availability", "summary": "\u0645\u062d\u0631\u0643 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u062a\u0648\u0641\u0631 \u0627\u0644\u063a\u0631\u0641 \u0648\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0633\u0639\u0627\u0631", "parameters": [], "responses": {"200": {"description": "OK", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/AvailableRoomOut"}, "title": "Response", "type": "array"}}}}}, "description": "\u064a\u0641\u062d\u0635 \u0627\u0644\u0634\u0648\u0627\u063a\u0631 \u0644\u0641\u062a\u0631\u0629 \u0632\u0645\u0646\u064a\u0629 \u0645\u062d\u062f\u062f\u0629 \u0648\u064a\u0645\u0646\u0639 \u0627\u0644\u062a\u0636\u0627\u0631\u0628\u060c\n\u0648\u064a\u0639\u064a\u062f \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u063a\u0631\u0641 \u0645\u0639 \u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u062d\u0633\u0648\u0628 \u0644\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a.", "tags": ["\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0645\u062d\u0631\u0643 \u0627\u0644\u062a\u0648\u0641\u0631 (Bookings)"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AvailabilityCheckIn"}}}, "required": true}}}, "/api/bookings/": {"post": {"operationId": "apps_bookings_api_make_booking", "summary": "\u0625\u0646\u0634\u0627\u0621 \u062d\u062c\u0632 \u062c\u062f\u064a\